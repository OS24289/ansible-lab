# ping localhost

[option variable       ] [cmd  ] [target ] [module]
ansible_connection=local ansible localhost -m package -a 'name=zsh'

# -b == become root
ansible_connection=local ansible localhost -b -m package -a 'name=zsh'
ansible_connection=local ansible localhost -m package -a 'name=zsh state=present'
